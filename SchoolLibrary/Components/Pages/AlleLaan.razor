@page "/admin/laan"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Librarian")]
@inject ILoanRepository LoanRepository
@inject IBookRepository BookRepository

<PageTitle>Alle lån</PageTitle>

<h1>@(showReturned ? "Alle lån" : "Aktive lån")</h1>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="showReturned" @bind="showReturned" @bind:after="Load" />
    <label class="form-check-label" for="showReturned">Vis også afleverede</label>
</div>

@if (loans.Count == 0)
{
    <p>Ingen lån at vise.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Bog</th>
                <th>Lånt af</th>
                <th>Lånt</th>
                <th>Afleveres senest</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in loans)
            {
                <tr>
                    <td>@TitleOf(loan.BookId)</td>
                    <td>@loan.Username</td>
                    <td>@loan.BorrowedAt.ToString("dd-MM-yyyy")</td>
                    <td>@loan.DueDate.ToString("dd-MM-yyyy")</td>
                    <td>
                        @if (!loan.IsReturned)
                        {
                            <span class="@(loan.IsOverdue ? "text-danger" : "")">@(loan.IsOverdue ? "Overskredet" : "Udlånt")</span>
                        }
                        else if (loan.IsLate)
                        {
                            <span class="text-danger">Afleveret for sent</span>
                        }
                        else
                        {
                            <span class="text-success">Afleveret ✔</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Loan> loans = new();
    private Dictionary<int, string> titles = new();
    private bool showReturned;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        titles = BookRepository.GetAllBooks().ToDictionary(b => b.Id, b => b.Title);
        loans = showReturned ? LoanRepository.GetAll() : LoanRepository.GetActive();
    }

    private string TitleOf(int bookId) => titles.TryGetValue(bookId, out var t) ? t : "(ukendt bog)";
}