@page "/books"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IBookRepository BookRepository
@inject ILoanService LoanService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Bøger</PageTitle>

<h1>Bøger</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(success ? "alert-success" : "alert-danger")">@message</div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Søg på titel eller forfatter..."
               @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="sortBy">
            <option value="title">Sortér efter titel</option>
            <option value="author">Sortér efter forfatter</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="onlyAvailable" @bind="onlyAvailable" />
            <label class="form-check-label" for="onlyAvailable">Kun ledige</label>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Total</th>
            <th>Available</th>
            <AuthorizeView Roles="Student">
                <th></th>
            </AuthorizeView>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in FilteredBooks)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Total</td>
                <td>@book.Available</td>
                <AuthorizeView Roles="Student">
                    <td>
                        <button class="btn btn-primary btn-sm" disabled="@(book.Available <= 0)" @onclick="() => Borrow(book.Id)">Lån</button>
                    </td>
                </AuthorizeView>
            </tr>
        }
    </tbody>
</table>

@code {
    private string searchText = "";
    private string sortBy = "title";
    private bool onlyAvailable;

    private List<Book> books = new();
    private string? message;
    private bool success;

    private IEnumerable<Book> FilteredBooks
    {
        get
        {
            var result = books.Where(b =>
                (string.IsNullOrWhiteSpace(searchText) ||
                 b.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                 b.Author.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                && (!onlyAvailable || b.Available > 0));

            return sortBy == "author"
                ? result.OrderBy(b => b.Author)
                : result.OrderBy(b => b.Title);
        }
    }

    protected override void OnInitialized()
    {
        books = BookRepository.GetAllBooks();
    }

    private async Task Borrow(int bookId)
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = state.User.Identity?.Name;

        if (string.IsNullOrEmpty(username))
        {
            success = false;
            message = "Du skal være logget ind.";
            return;
        }

        var result = LoanService.BorrowBook(username, bookId);
        success = result.Success;
        message = result.Message;

        books = BookRepository.GetAllBooks();
    }
}